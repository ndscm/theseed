bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "rules_python_gazelle_plugin", version = "2.3.2")

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.13",
)
use_repo(python, "python_3_13_host")

python_locks = use_extension("//seed/vendor/python:extensions.bzl", "python_locks")
python_locks.load_uv_lock(
    name = "python_locks",
    python = "@python_3_13_host//:python",
    uv_lock = "//:uv.lock",
)
use_repo(python_locks, "python_locks")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.13",
    requirements_lock = "@python_locks//:requirements.txt",
    # Resolve wheels for every platform we support so a single workstation can
    # introspect all wheels (e.g. to generate the gazelle modules mapping)
    # without needing one machine per OS. Wheels are fetched via the bazel
    # downloader and never executed, so cross-platform resolution is host
    # independent.
    target_platforms = [
        "linux_x86_64",
        "osx_aarch64",
    ],
)
use_repo(pip, "pypi")

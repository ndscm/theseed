bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")

# Dependencies that required by both bazel and go mod
bazel_dep(name = "cel-spec", version = "0.25.1", repo_name = "dev_cel_expr")
bazel_dep(name = "protoc-gen-validate", version = "1.3.3")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    experiments = ["jsonv2"],
    version = "1.27.0",
)

include("//:go.MODULE.bazel")

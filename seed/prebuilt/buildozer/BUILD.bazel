load("//seed/devprod/starlark/xslash:defs.bzl", "xslash_pack")

exports_files(
    glob(["bin/*"]),
)

xslash_pack(
    name = "buildozer_xslash",
    out = "buildozer.xslash",
    skeleton = "bin/buildozer.xslash",
    symlinks = ["buildozer"],
    visibility = ["//visibility:public"],
)

alias(
    name = "xslash",
    actual = ":buildozer_xslash",
    visibility = ["//visibility:public"],
)

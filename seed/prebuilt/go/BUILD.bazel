load("//seed/devprod/starlark/archive:defs.bzl", "merge_tar")
load("//seed/devprod/starlark/xslash:defs.bzl", "xslash_pack")

exports_files(
    glob(["bin/*"]),
)

xslash_pack(
    name = "go_xslash",
    out = "go.xslash",
    skeleton = "bin/go.xslash",
    symlinks = [
        "go",
    ],
    visibility = ["//visibility:public"],
)

xslash_pack(
    name = "gofmt_xslash",
    out = "gofmt.xslash",
    skeleton = "bin/gofmt.xslash",
    symlinks = [
        "gofmt",
    ],
    visibility = ["//visibility:public"],
)

merge_tar(
    name = "xslash",
    srcs = {
        ":go_xslash": ".",
        ":gofmt_xslash": ".",
    },
    visibility = ["//visibility:public"],
)

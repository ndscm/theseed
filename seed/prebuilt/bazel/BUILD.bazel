load("//seed/devprod/starlark/xslash:defs.bzl", "xslash_pack")

exports_files(
    glob(["bin/*"]),
)

xslash_pack(
    name = "bazelisk_xslash",
    out = "bazelisk.xslash",
    skeleton = "bin/bazelisk.xslash",
    symlinks = [
        "bazel",
        "bazelisk",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "xslash",
    actual = ":bazelisk_xslash",
    visibility = ["//visibility:public"],
)

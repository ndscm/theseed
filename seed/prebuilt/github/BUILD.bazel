load("//seed/devprod/starlark/xslash:defs.bzl", "xslash_pack")

exports_files(
    glob(["bin/*"]),
)

xslash_pack(
    name = "gh_xslash",
    out = "gh.xslash",
    skeleton = "bin/gh.xslash",
    symlinks = ["gh"],
    visibility = ["//visibility:public"],
)

alias(
    name = "xslash",

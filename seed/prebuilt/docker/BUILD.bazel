load("//seed/devprod/starlark/xslash:defs.bzl", "xslash_pack")

exports_files(
    glob(["bin/*"]),
)

xslash_pack(
    name = "docker_xslash",
    out = "docker.xslash",
    skeleton = "bin/docker.xslash",
    symlinks = ["docker"],
    visibility = ["//visibility:public"],
)

alias(
    name = "xslash",
    actual = ":docker_xslash",
    visibility = ["//visibility:public"],
)

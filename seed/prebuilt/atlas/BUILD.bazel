load("//seed/devprod/starlark/xslash:defs.bzl", "xslash_pack")

exports_files(
    glob(["bin/*"]),
)

xslash_pack(
    name = "atlas_xslash",
    out = "atlas.xslash",
    skeleton = "bin/atlas.xslash",
    symlinks = ["atlas"],
    visibility = ["//visibility:public"],
)

alias(
    name = "xslash",

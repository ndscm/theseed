load("@rules_go//go:def.bzl", "go_binary", "go_library")

alias(
    name = "server",
    actual = ":rbe-proxy-server",
)

go_library(
    name = "server_lib",
    srcs = ["server.go"],
    importpath = "github.com/ndscm/theseed/seed/devprod/rbe/proxy/server",
    visibility = ["//visibility:private"],
    deps = [
        "//seed/infra/error/go/seederr",
        "//seed/infra/flag/go/seedflag",
        "//seed/infra/init/go/seedinit",
        "//seed/infra/log/go/seedlog",
        "@org_golang_x_oauth2//:oauth2",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "rbe-proxy-server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

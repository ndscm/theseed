load("@rules_distroless//distroless:defs.bzl", "group", "home", "passwd")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//seed/devprod/container/starlark:transition.bzl", "layer_linux_x64")

layer_from_tar(
    name = "apt_layer",
    src = "@seed_devprod_workflow_builder_container_apt//:flat",
    target_compatible_with = ["@platforms//os:linux"],
)

layer_linux_x64(
    name = "apt_layer_linux_x64",
    actual = ":apt_layer",
)

pkg_tar(
    name = "bin_layer_tar",
    files = {
        "@dotslash_release_linux_x86_64//:bin": "/usr/local/bin/dotslash",
        "//seed/vendor/docker:bin/docker.dotslash": "/usr/local/bin/docker",
        "//seed/vendor/gcloud:bin/gcloud.dotslash": "/usr/local/bin/gcloud",
        "//seed/vendor/github:bin/gh.dotslash": "/usr/local/bin/gh",
        "//seed/vendor/ndscm:bin/ndscm.dotslash": "/usr/local/bin/ndscm",
    },
    mode = "0755",
)

layer_from_tar(
    name = "bin_layer",
    src = ":bin_layer_tar",
)

passwd(
    name = "etc_passwd",
    entries = [
        {
            "gid": 0,
            "home": "/root",
            "shell": "/bin/bash",
            "uid": 0,
            "username": "root",
        },
        {
            "gid": 1000,
            "home": "/home/builder",
            "shell": "/bin/bash",
            "uid": 1000,
            "username": "builder",
        },
    ],
)

layer_from_tar(
    name = "etc_passwd_layer",
    src = ":etc_passwd",
)

group(
    name = "etc_group",
    entries = [
        {
            "name": "root",
            "gid": 0,
        },
        {
            "name": "builder",
            "gid": 1000,
        },
    ],
)

layer_from_tar(
    name = "etc_group_layer",
    src = ":etc_group",
)

home(
    name = "home_builder",
    dirs = [
        {
            "gid": 1000,
            "home": "/home/builder",
            "uid": 1000,
        },
    ],
)

layer_from_tar(
    name = "home_builder_layer",
    src = ":home_builder",
)

image_manifest(
    name = "container",
    base = "//seed/devprod/container/debian:debian",
    env = {
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "TZ": "Etc/UTC",
        "USER": "builder",
    },
    layers = [
        ":apt_layer_linux_x64",
        ":bin_layer",
        ":etc_passwd_layer",
        ":etc_group_layer",
        ":home_builder_layer",
    ],
    platform = "//seed/devprod/platform:linux-x64",
    user = "builder",
    visibility = ["//visibility:public"],
    working_dir = "/home/builder",
)

image_load(
    name = "load",
    image = ":container",
    tag = "ghcr.io/ndscm/seed-devprod-workflow-builder-container:latest",
    visibility = ["//visibility:public"],
)

load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:load.bzl", "image_load")

# Cloud Build runs steps as the image user against a root-owned /workspace, so
# override the base builder image to run as root with /workspace as its working
# directory.
image_manifest(
    name = "container",
    base = "//seed/devprod/workflow/builder/container",
    config_fragment = "config.json",
)

image_load(
    name = "load-prod",
    image = ":container",
    tag = "us-docker.pkg.dev/ndscm-prod/container-us/seed-devprod-workflow-builder-deploy-gcloud:prod",
)

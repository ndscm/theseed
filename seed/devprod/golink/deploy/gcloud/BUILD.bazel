load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "image_layer")
load("@rules_img//img:load.bzl", "image_load")

# The prod openid issuer trust list, read by --trust_openid_issuers_file.
image_layer(
    name = "opt_golink_openid_issuers_layer",
    srcs = {
        "/opt/golink/openid_issuers.json": "openid_issuers.json",
    },
)

image_manifest(
    name = "prod",
    base = "//seed/devprod/golink/container",
    config_fragment = "prod.json",
    layers = [
        ":opt_golink_openid_issuers_layer",
    ],
)

image_load(
    name = "load-prod",
    image = ":prod",
    tag = "us-docker.pkg.dev/ndscm-prod/container-us/seed-devprod-golink-deploy-gcloud:prod",
)

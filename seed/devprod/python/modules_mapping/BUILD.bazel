load("@pypi//:requirements.bzl", "all_whl_requirements")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python_gazelle_plugin//modules_mapping:def.bzl", "modules_mapping")
load("//seed/devprod/platform:transition.bzl", "single_platform")

modules_mapping(
    name = "modules_mapping_native",
    modules_mapping_name = "modules_mapping_native.json",
    wheels = all_whl_requirements,
)

single_platform(
    name = "modules_mapping_linux",
    native = ":modules_mapping_native",
    platform = "//seed/devprod/platform/linux:amd64",
    target_compatible_with = ["@platforms//os:linux"],
)

single_platform(
    name = "modules_mapping_darwin",
    native = ":modules_mapping_native",
    platform = "//seed/devprod/platform/darwin:arm64",
)

py_binary(
    name = "merge",
    srcs = ["merge.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//seed/infra/flag/python:seed_flag",
        "//seed/infra/init/python:seed_init",
    ],
)

genrule(
    name = "modules_mapping",
    srcs = [
        ":modules_mapping_darwin",
        ":modules_mapping_linux",
    ],
    outs = ["modules_mapping.json"],
    cmd_bash = "$(execpath :merge) $(SRCS) > $@",
    tools = [":merge"],
    visibility = ["//visibility:public"],
)

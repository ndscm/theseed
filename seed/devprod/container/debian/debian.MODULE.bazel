pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

apt_dists = use_repo_rule("//seed/devprod/container/starlark:apt.bzl", "apt_dists")

apt_pool = use_repo_rule("//seed/devprod/container/starlark:apt.bzl", "apt_pool")

pull(
    name = "seed_devprod_container_debian_13",
    digest = "sha256:34cd9e9fd437c0a095ec39cb2e73422c9f30821b0d0848ed74fd0d43bae4d958",
    registry = "index.docker.io",
    repository = "library/debian",
    tag = "13",
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = [
        "trixie",
        "trixie-updates",
    ],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20260901T000000Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["trixie-security"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20260901T000000Z"],
)
apt.install(
    dependency_set = "seed_devprod_container_debian_13_apt",
    packages = [
        "ca-certificates",
        "curl",
        "iputils-ping",
    ],
    suites = [
        "trixie",
        "trixie-security",
        "trixie-updates",
    ],
)
use_repo(apt, "seed_devprod_container_debian_13_apt")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "seed_devprod_container_debian_13_oci",
    digest = "sha256:34cd9e9fd437c0a095ec39cb2e73422c9f30821b0d0848ed74fd0d43bae4d958",
    image = "index.docker.io/library/debian",
    platforms = ["linux/amd64"],
    tag = "13",
)
use_repo(
    oci,
    "seed_devprod_container_debian_13_oci",
    "seed_devprod_container_debian_13_oci_linux_amd64",
)

# run `bazel run @seed_devprod_container_debian_13_apt_dists//:lock` to update the lockfile.
apt_dists(
    name = "seed_devprod_container_debian_13_apt_dists",
    archs = ["amd64"],
    lock = "//seed/devprod/container/debian:13_apt_dists.lock.json",
    sources = "//seed/devprod/container/debian:debian.sources",
)

# run `bazel run @seed_devprod_container_debian_13_apt_pool//:lock` to update the lockfile.
apt_pool(
    name = "seed_devprod_container_debian_13_apt_pool",
    archs = ["amd64"],
    dists = "@seed_devprod_container_debian_13_apt_dists",
    lock = "//seed/devprod/container/debian:13_apt_pool.lock.json",
    packages = [
        "ca-certificates",
        "curl",
        "iputils-ping",
    ],
    sources = "//seed/devprod/container/debian:debian.sources",
)

load("@rules_distroless//distroless:defs.bzl", "cacerts")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("//seed/devprod/container/starlark:apt.bzl", "apt_mirror")
load("//seed/devprod/container/starlark:container.bzl", "build_freedom_image")
load("//seed/devprod/container/starlark:transition.bzl", "layer_linux_x64")

layer_from_tar(
    name = "13_apt_layer",
    src = "@seed_devprod_container_debian_13_apt//:flat",
    target_compatible_with = ["@platforms//os:linux"],
)

layer_linux_x64(
    name = "13_apt_layer_linux_x64",
    actual = ":13_apt_layer",
)

# rules_distroless installs the `ca-certificates` .deb but does not run its
# postinst (`update-ca-certificates`), so the /etc/ssl/certs/ca-certificates.crt
# bundle that TLS clients read is never generated. Build it explicitly.
cacerts(
    name = "13_cacerts",
    package = "@seed_devprod_container_debian_13_apt//ca-certificates:data",
    target_compatible_with = ["@platforms//os:linux"],
)

layer_from_tar(
    name = "13_cacerts_layer",
    src = ":13_cacerts",
    target_compatible_with = ["@platforms//os:linux"],
)

layer_linux_x64(
    name = "13_cacerts_layer_linux_x64",
    actual = ":13_cacerts_layer",
)

image_manifest(
    name = "debian_13",
    base = "@seed_devprod_container_debian_13",
    env = {
        "DEBIAN_FRONTEND": "noninteractive",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    },
    layers = [
        ":13_apt_layer_linux_x64",
        ":13_cacerts_layer_linux_x64",
    ],
    platform = "//seed/devprod/platform:linux-x64",
    visibility = ["//visibility:public"],
)

alias(
    name = "debian",
    actual = ":debian_13",
    visibility = ["//visibility:public"],
)

image_load(
    name = "load",
    image = ":debian",
    tag = "ghcr.io/ndscm/debian:latest",
)

apt_mirror(
    name = "debian_13_freedom_apt_mirror",
    dists = "@seed_devprod_container_debian_13_apt_dists",
    pool = "@seed_devprod_container_debian_13_apt_pool",
    sources = "//seed/devprod/container/debian:debian.sources",
)

build_freedom_image(
    name = "debian_13_freedom",
    srcs = [
        "debian.sources",
        ":debian_13_freedom_apt_mirror",
    ],
    base = "@seed_devprod_container_debian_13_oci",
    containerfile = "Containerfile",
    image_tag = "ghcr.io/ndscm/debian:13-freedom",
    squash = True,
    visibility = ["//visibility:public"],
)

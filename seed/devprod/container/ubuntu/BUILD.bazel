load("@rules_distroless//distroless:defs.bzl", "cacerts")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")

layer_from_tar(
    name = "apt_layer",
    src = "@seed_devprod_container_ubuntu_2604_apt//:flat",
)

# rules_distroless installs the `ca-certificates` .deb but does not run its
# postinst (`update-ca-certificates`), so the /etc/ssl/certs/ca-certificates.crt
# bundle that TLS clients read is never generated. Build it explicitly.
cacerts(
    name = "cacerts",
    package = "@seed_devprod_container_ubuntu_2604_apt//ca-certificates:data",
)

layer_from_tar(
    name = "cacerts_layer",
    src = ":cacerts",
)

image_manifest(
    name = "ubuntu",
    base = "@seed_devprod_container_ubuntu_2604",
    env = {
        "DEBIAN_FRONTEND": "noninteractive",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    },
    layers = [
        ":apt_layer",
        ":cacerts_layer",
    ],
    visibility = ["//visibility:public"],
)

image_load(
    name = "load",
    image = ":ubuntu",
    tag = "ghcr.io/ndscm/ubuntu:latest",
)

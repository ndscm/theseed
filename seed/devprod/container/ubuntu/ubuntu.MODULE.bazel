    name = "seed_devprod_container_ubuntu_2604_apt_pool",
    archs = ["amd64"],
    dists = "@seed_devprod_container_ubuntu_2604_apt_dists",
    lock = "//seed/devprod/container/ubuntu:2604_apt_pool.lock.json",
    packages = [

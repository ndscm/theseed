apt_dists(
    name = "seed_devprod_container_ubuntu_2604_apt_dists",
    archs = ["amd64"],
    lock = "//seed/devprod/container/ubuntu:2604_apt_dists.lock.json",
    sources = "//seed/devprod/container/ubuntu:ubuntu.sources",

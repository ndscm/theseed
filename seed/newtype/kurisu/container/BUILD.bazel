load("@rules_distroless//distroless:defs.bzl", "group", "home", "passwd")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_binary", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")

layer_from_binary(
    name = "opt_kurisu_layer",
    binary = "//seed/newtype/kurisu/server:kurisu-server",
    path = "/opt/kurisu/kurisu-server",
)

# One layer per tar. They are kept separate rather than flattened because
# `passwd` and `group` each emit an `/etc` directory entry, and a single layer
# tar with duplicate paths is rejected by `docker load`. Duplicate paths across
# distinct layers are fine.

passwd(
    name = "etc_passwd",
    entries = [
        {
            "gid": 0,
            "home": "/root",
            "shell": "/bin/bash",
            "uid": 0,
            "username": "root",
        },
        {
            "gid": 1000,
            "home": "/home/kurisu",
            "shell": "/bin/bash",
            "uid": 1000,
            "username": "kurisu",
        },
    ],
)

layer_from_tar(
    name = "etc_passwd_layer",
    src = ":etc_passwd",
)

group(
    name = "etc_group",
    entries = [
        {
            "name": "root",
            "gid": 0,
        },
        {
            "name": "kurisu",
            "gid": 1000,
        },
    ],
)

layer_from_tar(
    name = "etc_group_layer",
    src = ":etc_group",
)

home(
    name = "home_kurisu",
    dirs = [
        {
            "gid": 1000,
            "home": "/home/kurisu",
            "uid": 1000,
        },
    ],
)

layer_from_tar(
    name = "home_kurisu_layer",
    src = ":home_kurisu",
)

image_manifest(
    name = "container",
    base = "//seed/devprod/container/ubuntu:ubuntu",
    config_fragment = "config.json",
    layers = [
        ":opt_kurisu_layer",
        ":etc_passwd_layer",
        ":etc_group_layer",
        ":home_kurisu_layer",
    ],
    visibility = ["//visibility:public"],
    # Explicit override: opt_kurisu_layer (layer_from_binary) sets working_dir
    # to the binary's runfiles root, and layer config beats config_fragment.
    # Only a rule attr wins over the layer, so working_dir stays here.
    working_dir = "/home/kurisu",
)

image_load(
    name = "load",
    image = ":container",
    tag = "ghcr.io/ndscm/seed-newtype-kurisu-container:latest",
    visibility = ["//visibility:public"],
)

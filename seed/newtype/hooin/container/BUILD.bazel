load("@rules_distroless//distroless:defs.bzl", "group", "home", "passwd")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_binary", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("//seed/devprod/container/starlark:transition.bzl", "layer_single_platform")

# Debug tooling (gnupg2, lsb-release) resolved as .debs by rules_distroless.
# `curl` already ships in the ubuntu base, so it is not repeated here. See
# apt.MODULE.bazel for the package list; resolution is pinned in
# MODULE.bazel.lock.
layer_from_tar(
    name = "apt_layer",
    src = "@seed_newtype_hooin_container_apt//:flat",
    target_compatible_with = ["@platforms//os:linux"],
)

layer_single_platform(
    name = "apt_layer_linux_amd64",
    native = ":apt_layer",
    platform = "//seed/devprod/platform/linux:amd64",
)

layer_from_binary(
    name = "opt_hooin_layer",
    binary = "//seed/newtype/hooin/server:hooin-server",
    path = "/opt/hooin/hooin-server",
)

# One layer per tar. They are kept separate rather than flattened because
# `passwd` and `group` each emit an `/etc` directory entry, and a single layer
# tar with duplicate paths is rejected by `docker load`. Duplicate paths across
# distinct layers are fine.

passwd(
    name = "etc_passwd",
    entries = [
        {
            "gid": 0,
            "home": "/root",
            "shell": "/bin/bash",
            "uid": 0,
            "username": "root",
        },
        {
            "gid": 1000,
            "home": "/home/hooin",
            "shell": "/bin/bash",
            "uid": 1000,
            "username": "hooin",
        },
    ],
)

layer_from_tar(
    name = "etc_passwd_layer",
    src = ":etc_passwd",
)

group(
    name = "etc_group",
    entries = [
        {
            "name": "root",
            "gid": 0,
        },
        {
            "name": "hooin",
            "gid": 1000,
        },
    ],
)

layer_from_tar(
    name = "etc_group_layer",
    src = ":etc_group",
)

home(
    name = "home_hooin",
    dirs = [
        {
            "gid": 1000,
            "home": "/home/hooin",
            "uid": 1000,
        },
    ],
)

layer_from_tar(
    name = "home_hooin_layer",
    src = ":home_hooin",
)

image_manifest(
    name = "container",
    base = "//seed/devprod/container/ubuntu:ubuntu",
    entrypoint = ["/opt/hooin/hooin-server"],
    layers = [
        ":apt_layer_linux_amd64",
        ":opt_hooin_layer",
        ":etc_passwd_layer",
        ":etc_group_layer",
        ":home_hooin_layer",
    ],
    platform = "//seed/devprod/platform/linux:amd64",
    user = "hooin",
    visibility = ["//visibility:public"],
    working_dir = "/home/hooin",
)

image_load(
    name = "load",
    image = ":container",
    tag = "ghcr.io/ndscm/seed-newtype-hooin-container:latest",
)

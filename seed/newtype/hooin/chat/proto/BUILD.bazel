load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("//seed/devprod/go:proto.bzl", "go_connect_library")
load("//seed/devprod/ndscm/starlark:defs.bzl", "nd_bootstrap")

package(default_visibility = [
    "//seed/newtype/hooin:__subpackages__",
])

proto_library(
    name = "chat_proto",
    srcs = ["chat.proto"],
    deps = [
        "@protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "chat_go_proto",
    compilers = ["@rules_go//proto:go_grpc"],
    importpath = "github.com/ndscm/theseed/seed/newtype/hooin/chat/proto/chatpb",
    proto = ":chat_proto",
)

go_connect_library(
    name = "chat_go_connect",
    importpath = "github.com/ndscm/theseed/seed/newtype/hooin/chat/proto/chatpbconnect",
    proto = ":chat_proto",
    deps = [
        ":chat_go_proto",
        "@com_connectrpc_connect//:connect",
    ],
)

ts_proto_library(
    name = "chat_ts_proto",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":chat_proto",
)

npm_package(
    name = "chat_ts_proto_pkg",
    srcs = [
        ":chat_ts_proto",
    ],
)

alias(
    name = "pkg",  # Required by aspect_rules_js
    actual = ":chat_ts_proto_pkg",
    visibility = ["//visibility:public"],
)

nd_bootstrap(
    dsts = [
        {
            "dst": "chatpb",
            "dir": True,
            "srcs": [{
                "src": ":chat_go_proto",
                "output_group": "go_generated_srcs",
            }],
        },
        {
            "dst": "chatpbconnect",
            "dir": True,
            "srcs": [{
                "src": ":chat_go_connect_go",
            }],
        },
        {
            "dst": "chat_pb.js",
            "srcs": [{
                "src": ":chat_ts_proto",
            }],
        },
        {
            "dst": "chat_pb.d.ts",
            "srcs": [{
                "src": ":chat_ts_proto",
                "output_group": "types",
            }],
        },
    ],
)

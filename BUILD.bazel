genrule(
    name = "noop",
    outs = ["noop.sh"],
    cmd_bash = "printf '#!/bin/sh\\nexit 0\\n' > $@",
    executable = True,
)

# CC

refresh_compile_commands(
    name = "refresh_compile_commands",
    targets = {
    },
)

# Node

npm_link_all_packages()

# Python

# The manifest merges the per-OS modules mappings, one of which resolves the
# Linux wheels. evdev is Linux-only and ships no wheels (sdist only), so building
# that mapping compiles evdev from source, which needs Linux kernel headers. That
# compile only succeeds on a Linux host, so the manifest can only be regenerated
# on Linux for now; on other hosts the target is incompatible and skipped.
gazelle_python_manifest(
    name = "gazelle_python_manifest",
    modules_mapping = "//seed/devprod/python/modules_mapping",
    pip_repository_name = "pypi",
    requirements = [
        "@python_locks//:requirements.txt",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "update_gazelle_python_manifest",
    actual = select({
        "@platforms//os:linux": ":gazelle_python_manifest.update",
        "//conditions:default": ":noop",
    }),
)

# Gazelle

gazelle_binary(
    name = "gazelle_extend",
    languages = [
        "@gazelle//language/go",  # built-in
        "@gazelle//language/proto",  # built-in
        # Other languages
        "@rules_python_gazelle_plugin//python",
    ],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_extend",
)
